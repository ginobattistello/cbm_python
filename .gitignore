__pycache__/
*.pyc
*.pyo
*.egg-info/

# macOS
.DS_Store

# Generated by examples/*.py — regenerate by re-running them.
# NOTE: cbm/dev/baseline.json is deliberately NOT ignored; it is the
# committed A/B reference for DEV.md §7 step 4.
examples/output/*.pkl
examples/output/*.log

# Third-party clone (4 MB); see benchmark/external/README.md to re-create.
# cbm_original/ IS tracked — it is the pristine-baseline comparison arm.
benchmark/external/VBA-toolbox/
# Benchmark run artifacts (datasets + per-arm results); regenerate by
# re-running the harness. Summary tables/reports ARE tracked.
benchmark/data/
benchmark/results/*.npz
benchmark/results/*.mat
benchmark/results/*.pkl
